# Copia este archivo a .env y completa los DOS valores de abajo:
#   cp .env.example .env          (Linux / macOS / Git Bash)
#   Copy-Item .env.example .env   (PowerShell)
# Después de cambiar algo aquí: docker compose up -d

# --- Modelo (LLM) -------------------------------------------------------------
# Opción A - llave del taller (te llegó por correo o te la entregó el organizador):
#   LLM_BASE_URL = la URL que viene con tu llave
#   LLM_API_KEY  = tu llave  sk-bintec-...
#
# Opción B - tu propia API key de Gemini (https://aistudio.google.com/api-keys):
#   LLM_BASE_URL = https://generativelanguage.googleapis.com
#   LLM_API_KEY  = tu API key de Gemini
LLM_BASE_URL=
LLM_API_KEY=

# --- Opcional -----------------------------------------------------------------
# Modelo a usar con la opción B (con la llave del taller el modelo lo define el organizador).
# LLM_MODEL=gemini-3.5-flash-lite

# Cambia el puerto si el 5678 ya está ocupado en tu equipo.
# N8N_PORT=5678
